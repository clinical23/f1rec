# Supply chain hardening (Cursor Prompt 47, 16 April 2026)
# Prevents lifecycle scripts from auto-executing on install — blocks the class
# of attack used by the Axios compromise (malicious postinstall in plain-crypto-js).
ignore-scripts=true

# Force installs to respect the engines field in package.json
engine-strict=true

# Exact versions only — reject floating ranges when saving new packages
save-exact=true

# Prevent npm from auto-rewriting package-lock.json during normal installs;
# lockfile changes must be deliberate.
package-lock=true

# Reject deprecated algorithms during integrity verification
fund=false
audit-level=moderate
